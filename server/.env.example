# Copy to .env. Never commit the real file.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/medico

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Two different secrets: a leaked access secret must not be able to mint refresh tokens.
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Allowed origins for the web build, comma separated. Native apps send no Origin.
CORS_ORIGINS=http://localhost:3000
